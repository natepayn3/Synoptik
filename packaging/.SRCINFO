pkgbase = synoptik
	pkgdesc = A fluid, morphing desktop shell for Hyprland, built in Quickshell
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/natepayn3/Synoptik
	arch = any
	license = MIT
	depends = quickshell-git
	depends = hyprland
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-5compat
	depends = qt6-multimedia
	depends = qt6-imageformats
	depends = fish
	depends = python
	depends = ttf-material-symbols-variable-git
	depends = wireplumber
	depends = pipewire
	depends = pipewire-pulse
	depends = networkmanager
	depends = bluez-utils
	depends = brightnessctl
	depends = playerctl
	depends = wl-clipboard
	depends = libnotify
	depends = polkit
	depends = curl
	depends = jq
	optdepends = cava: desktop audio visualizer
	optdepends = awww: wallpaper switching with transitions
	optdepends = mpvpaper: animated/video wallpapers
	optdepends = cliphist: clipboard history
	optdepends = iris-colors: derive the colour scheme from the current wallpaper
	optdepends = sddm: to use the bundled Synoptik login greeter
	optdepends = hypridle: idle handling and screen locking
	optdepends = grim: screenshots
	optdepends = slurp: region selection for screenshots
	optdepends = satty: screenshot annotation
	optdepends = wf-recorder: screen recording
	optdepends = showmethekey: on-screen key display
	optdepends = power-profiles-daemon: power profile switching from the control center
	optdepends = qt6-webview: in-shell web views
	optdepends = qt6-multimedia-ffmpeg: wider media format support
	optdepends = gst-plugins-good: additional media codecs
	optdepends = gst-plugins-bad: additional media codecs
	optdepends = gst-plugin-pipewire: PipeWire media backend
	optdepends = v4l-utils: webcam support for the Mirror widget
	optdepends = python-gobject: helper scripts that use GObject introspection
	optdepends = noto-fonts-emoji: emoji rendering in the launcher and notifications
	optdepends = libcanberra: system sound effects
	optdepends = ffmpeg: media thumbnailing and conversion
